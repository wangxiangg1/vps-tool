# Copy this file to .env and replace the administrator values before starting.
VPS_TOOL_IMAGE=ghcr.io/wangxiangg1/vps-tool:latest
VPS_TOOL_BACKUP_DIR=/data/backups
VPS_TOOL_BIND_ADDRESS=127.0.0.1
VPS_TOOL_PORT=8000
VPS_TOOL_ADMIN_USER=admin
VPS_TOOL_ADMIN_PASSWORD=change-this-password-before-starting-123
VPS_TOOL_COOKIE_SECURE=true
